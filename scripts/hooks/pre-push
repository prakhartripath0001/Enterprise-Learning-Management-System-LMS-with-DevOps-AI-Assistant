#!/bin/bash

# ==============================================================================
# Git Pre-Push Hook
# Runs: Full test suite, coverage, static analysis, and security scan
# Blocks push if any check fails
# ==============================================================================

set -eo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
SERVICES=("auth-service")

echo -e "${YELLOW}▶ Running pre-push validation...${NC}"

# ── Unit Tests ────────────────────────────────────────────────────────────────
for service in "${SERVICES[@]}"; do
  echo -e "${YELLOW}  Running tests for $service...${NC}"
  if ! (cd "$ROOT_DIR/$service" && ./mvnw clean test -q); then
    echo -e "${RED}✘ Pre-push FAILED: $service unit tests did not pass.${NC}"
    exit 1
  fi
done
echo -e "${GREEN}  ✔ Unit tests passed${NC}"

# ── Coverage Check (mvn verify) ───────────────────────────────────────────────
for service in "${SERVICES[@]}"; do
  echo -e "${YELLOW}  Running coverage check for $service...${NC}"
  if ! (cd "$ROOT_DIR/$service" && ./mvnw verify -DskipTests=false -q); then
    echo -e "${RED}✘ Pre-push FAILED: $service coverage below threshold.${NC}"
    exit 1
  fi
done
echo -e "${GREEN}  ✔ Coverage thresholds met${NC}"

# ── Security Scan ─────────────────────────────────────────────────────────────
"$ROOT_DIR/scripts/security-scan.sh" || {
  echo -e "${RED}✘ Pre-push FAILED: Security scan found violations.${NC}"
  exit 1
}

echo -e "${GREEN}✔ Pre-push validation passed. Proceeding with push.${NC}"
exit 0
